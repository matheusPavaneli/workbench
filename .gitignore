# Workflow artifacts are per-checkout scratch, except the context binding and a
# local backlog -- a backlog only one person can see is not a backlog.
.workflow/*
!.workflow/config.json
!.workflow/tasks/

__pycache__/
*.py[cod]
.pytest_cache/

# Recordings of a real tenant, written by `wb ctx record`. Ignored by default:
# committing one is a decision to make deliberately, after reading it, and the
# suite works either way -- it picks them up locally and skips without them.
tests/fixtures/*/local/
