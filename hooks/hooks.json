{
  "description": "workbench: refuse edits outside the active ticket's audited plan, and report unverified work at stop",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/lib/wb_hook.py\" pre-tool-use",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/lib/wb_hook.py\" stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
